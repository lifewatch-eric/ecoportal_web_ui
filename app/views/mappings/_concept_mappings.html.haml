= turbo_frame_tag 'mapping_count' do
  = "#{@mappings.size}"

= turbo_frame_tag @type.eql?('modal') ? 'application_modal_content' : 'concept_mappings' do
  %div.p-1
    .d-inline-block.mb-3
      - if session[:user].nil?
        = link_to t('mappings.create_new_mapping'), "/login?redirect=/ontologies/#{@ontology.acronym}/?p=classes&t=mappings&conceptid=#{escape(@concept.id)}", class: "secondary-button regular-button slim", data: { turbo_frame: '_top' }
      - else
        = link_to_modal t('mappings.create_new_mapping'),
                        new_mapping_path(ontology_from: @ontology.id, conceptid_from: @concept.id),
                        id: 'new_mapping_btn', class: 'secondary-button regular-button slim',
                        data: { show_modal_title_value: "Create a new mapping for #{@concept.prefLabel}" }

    #mapping_details
      = render :partial => '/mappings/mapping_table'
