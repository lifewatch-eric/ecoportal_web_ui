[Unit]
Description=Validated public-only EcoPortal SPARQL refresh
After=virtuoso.service virtuoso-public.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/ecoportal/refresh_public_sparql.py --refresh
ExecStopPost=/usr/bin/python3 /usr/local/lib/ecoportal/refresh_public_sparql.py --restore-checkpoint
TimeoutStartSec=30min
TimeoutStopSec=120
KillMode=mixed
Nice=10
